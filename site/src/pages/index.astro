---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import CategoryCard from '../components/CategoryCard.astro';
import EditorialCard from '../components/EditorialCard.astro';
import { categories, guides } from '../data/content';
---
<BaseLayout title="Nutra Lens" description="Nutra Lens brings clear, measured context to supplements and wellness products. Explore practical guides, editorial categories, and our review approach.">
  <section class="hero" aria-labelledby="hero-heading">
    <Container class="hero__grid">
      <div>
        <span class="eyebrow">A closer look at wellness</span>
        <h1 id="hero-heading">See beyond <em>the claim.</em></h1>
        <p class="hero__lead">Supplements and wellness products come with a lot of promises. Nutra Lens helps you examine the details, understand the questions, and make sense of what matters.</p>
        <div class="hero__actions"><a class="button" href="/categories/supplements/">Explore supplements <span aria-hidden="true">↗</span></a><a class="button button--light" href="/how-we-review/">Our approach <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="lens-art" role="img" aria-label="Abstract illustration of a lens looking closely at layered details">
        <span class="lens-art__tag lens-art__tag--one">Look closer</span><span class="lens-art__tag lens-art__tag--two">Ask better questions</span><span class="lens-art__tag lens-art__tag--three">Find context</span>
      </div>
    </Container>
  </section>
  <div class="intro-strip"><Container class="intro-strip__inner"><span class="eyebrow">The Nutra Lens perspective</span><p>Useful product information should be easy to examine, honest about uncertainty, and clear about where a claim comes from.</p></Container></div>
  <Container>
    <section class="section-block" aria-labelledby="explore-heading">
      <div class="section-heading"><div><span class="eyebrow">Explore by interest</span><h2 id="explore-heading">Find your focus.</h2></div><p>Start with a subject. Each area is built to grow into a clear home for guides, product analysis, and reviews.</p></div>
      <div class="category-grid">{categories.map((category, index) => <CategoryCard category={category} index={index} />)}</div>
    </section>
    <section class="section-block" aria-labelledby="reading-heading">
      <div class="section-heading"><div><span class="eyebrow">Start reading</span><h2 id="reading-heading">A little more clarity.</h2></div><a class="text-link" href="/research/">Explore research <span aria-hidden="true">↗</span></a></div>
      <div class="editorial-grid">{guides.map((item) => <EditorialCard item={item} featured />)}</div>
    </section>
    <section class="method-panel" aria-labelledby="method-heading">
      <div class="method-panel__intro"><span class="eyebrow">Our method</span><h2 id="method-heading">The details deserve attention.</h2><p>Our review framework is designed to make product information easier to compare and claims easier to evaluate.</p><a class="text-link" href="/how-we-review/">How we review <span aria-hidden="true">↗</span></a></div>
      <div class="method-panel__steps">
        <div class="method-step"><span class="method-step__number">01</span><h3>Identify the claim</h3><p>What does a product say it does, and how specific is that promise?</p></div>
        <div class="method-step"><span class="method-step__number">02</span><h3>Read the label</h3><p>Which ingredients, amounts, directions, and warnings are disclosed?</p></div>
        <div class="method-step"><span class="method-step__number">03</span><h3>Examine the support</h3><p>What evidence is relevant, and where are its limits?</p></div>
        <div class="method-step"><span class="method-step__number">04</span><h3>Put it in context</h3><p>How do price, policies, and practical considerations affect the picture?</p></div>
      </div>
    </section>
    <section class="institutional-band" aria-labelledby="about-heading"><div><span class="eyebrow">About Nutra Lens</span><h2 id="about-heading">Curiosity with a clear point of view.</h2><p>We are building an independent editorial resource for people who want to look more closely at supplement and wellness products. Our policies explain how we intend to work as the library grows.</p></div><a class="button" href="/about/">Get to know us <span aria-hidden="true">↗</span></a></section>
    <section class="section-block" aria-labelledby="next-heading"><div class="section-heading"><div><span class="eyebrow">Keep exploring</span><h2 id="next-heading">Begin with the basics.</h2></div><a class="button button--light" href="/categories/supplements/">Browse all topics <span aria-hidden="true">↗</span></a></div></section>
  </Container>
</BaseLayout>
