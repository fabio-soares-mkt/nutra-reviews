---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { categories, guides } from '../../data/content';
import type { Category } from '../../data/content';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
interface Props { category: Category }
const { category } = Astro.props;
const relatedGuides = guides.filter((guide) => guide.category === category.title);
const otherCategories = categories.filter(({ slug }) => slug !== category.slug).slice(0, 3);
---
<BaseLayout title={category.title} description={category.description}>
  <div class="page-hero"><Container><Breadcrumbs items={[{ label: category.title }]} /><div class="page-hero__inner"><span class="eyebrow">Explore the subject</span><h1>{category.title}</h1><p>{category.description}</p><div class="topic-chips" aria-label="Topics in this category">{category.focus.map((topic) => <span>{topic}</span>)}</div></div></Container></div>
  <Container>
    <div class="category-content"><p class="category-content__intro">This area is taking shape. We begin with the fundamentals: what a product contains, what it claims, and what information can help put those claims in context.</p></div>
    <section class="section-block" aria-labelledby="category-reading"><div class="section-heading"><div><span class="eyebrow">The reading desk</span><h2 id="category-reading">Start here</h2></div></div>
      {relatedGuides.length > 0 ? <div class="editorial-grid">{relatedGuides.map((item) => <EditorialCard item={item} />)}</div> : <div class="empty-note"><p>Category-specific guides and product reviews are being developed. For now, explore <a class="text-link" href="/guides/what-makes-a-useful-review/">our review framework <span aria-hidden="true">↗</span></a> and the broader <a class="text-link" href="/research/">research desk <span aria-hidden="true">↗</span></a>.</p></div>}
    </section>
    <section class="section-block" aria-labelledby="other-categories"><div class="section-heading"><div><span class="eyebrow">Keep looking</span><h2 id="other-categories">Explore more areas</h2></div></div><div class="category-grid">{otherCategories.map((item, index) => <CategoryCard category={item} index={index} />)}</div></section>
  </Container>
</BaseLayout>
