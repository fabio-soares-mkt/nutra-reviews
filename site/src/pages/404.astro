---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found on Nutra Lens." noindex>
  <Container class="not-found"><span class="eyebrow">404 · Page not found</span><h1>Let's take another look.</h1><p>That page may have moved, or the address may be incomplete.</p><a class="button" href="/">Return to the home page <span aria-hidden="true">↗</span></a></Container>
</BaseLayout>
