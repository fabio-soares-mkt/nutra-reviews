---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<a class:list={['brand', { 'brand--compact': compact }]} href="/" aria-label="Nutra Lens home">
  <svg class="brand__symbol" viewBox="0 0 46 46" fill="none" aria-hidden="true">
    <circle cx="21" cy="21" r="14.5" stroke="currentColor" stroke-width="2.5" />
    <circle cx="21" cy="21" r="6" stroke="currentColor" stroke-width="2" />
    <path d="M31.5 31.5 42 42" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <path d="M21 3v5M3 21h5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="brand__wordmark">Nutra<span>Lens</span></span>
</a>
