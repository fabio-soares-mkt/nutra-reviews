---
import { Image } from 'astro:assets';
import type { EditorialItem } from '../data/content';
interface Props { item: EditorialItem; featured?: boolean }
const { item, featured = false } = Astro.props;
---
<article class:list={['editorial-card', { 'editorial-card--featured': featured }]}>
  <div class:list={['editorial-card__visual', { 'editorial-card__visual--photo': item.image, 'editorial-card__visual--product': item.label === 'Review' }]} aria-hidden={item.image ? undefined : 'true'}>
    {item.image ? <Image src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" /> : <><span class="editorial-card__rings"></span><span>{item.category}</span></>}
  </div>
  <div class="editorial-card__content">
    <div class="editorial-card__meta"><span>{item.label}</span><span>·</span><span>{item.category}</span></div>
    <h3><a href={item.href}>{item.title}</a></h3>
    <p>{item.description}</p>
    <a class="text-link" href={item.href}>{item.label === 'Review' ? 'Read review' : 'Read guide'} <span aria-hidden="true">↗</span></a>
  </div>
</article>
<style>
  .editorial-card__visual--photo { padding: 0; background: var(--surface-pale); }
  .editorial-card__visual--product,
  .editorial-card:nth-child(2n) .editorial-card__visual--product { background: var(--white); }
  .editorial-card__visual--photo :global(img) { display: block; width: 100%; height: 100%; min-height: 200px; object-fit: cover; }
  .editorial-card__visual--product :global(img) { object-fit: contain; padding: .75rem; }
  @media (max-width: 390px) { .editorial-card__visual--photo :global(img) { min-height: 115px; max-height: 180px; } }
</style>
