---
import type { EditorialItem } from '../data/content';
interface Props { item: EditorialItem; featured?: boolean }
const { item, featured = false } = Astro.props;
---
<article class:list={['editorial-card', { 'editorial-card--featured': featured }]}>
  <div class="editorial-card__visual" aria-hidden="true"><span class="editorial-card__rings"></span><span>{item.category}</span></div>
  <div class="editorial-card__content">
    <div class="editorial-card__meta"><span>{item.label}</span><span>·</span><span>{item.category}</span></div>
    <h3><a href={item.href}>{item.title}</a></h3>
    <p>{item.description}</p>
    <a class="text-link" href={item.href}>{item.label === 'Review' ? 'Read review' : 'Read guide'} <span aria-hidden="true">↗</span></a>
  </div>
</article>
